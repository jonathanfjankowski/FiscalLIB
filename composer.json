{
    "name": "jonathanfjankowski/fiscal-lib",
    "description": "Biblioteca fiscal PHP: motor tributário, regras de NF-e/NFC-e/NFS-e Nacional e adaptador para a FiscalAPI. Núcleo agnóstico de transporte via EmissorInterface.",
    "type": "library",
    "license": "MIT",
    "keywords": ["nfe", "nfce", "nfse", "fiscal", "sefaz", "tributos", "ibscbs"],
    "authors": [
        {
            "name": "Jonathan Floriano Jankowski"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-bcmath": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "illuminate/support": "Para o ServiceProvider/Facade opcional do Laravel"
    },
    "autoload": {
        "psr-4": {
            "FiscalLib\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FiscalLib\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testsuite Unit,Contract,Port",
        "test:integration": "phpunit --testsuite Integration",
        "stan": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "stable"
}
